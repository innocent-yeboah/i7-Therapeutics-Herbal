# Copy to .env.local and fill in values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Paystack (Dashboard → Settings → API Keys)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxx

# Cron (generate a long random string; Vercel Cron sends Authorization: Bearer <secret>)
CRON_SECRET=

# WhatsApp reminders — optional Twilio WhatsApp
# If unset, cron still marks reminders and logs wa.me links server-side.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Business WhatsApp (digits only, country code, no +) for site buttons & message templates
NEXT_PUBLIC_BUSINESS_WHATSAPP=233552473681

# Email follow-ups — optional (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
